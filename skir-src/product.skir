struct Product {
  id: string = 0;
  name: string = 1;
  parent_product_id: string? = 2;
  child_product_ids: [string] = 3;
}

struct CreateProductRequest {
  name: string = 0;
  parent_product_id: string? = 1;
}

struct ProductListResponse {
  data: [Product] = 0;
  total: int32 = 1;
  offset: int32 = 2;
  limit: int32 = 3;
}

struct GetProductRequest {
  id: string = 0;
}

struct ListProductsRequest {
  offset: int32 = 0;
  limit: int32 = 1;
}

struct DeleteProductRequest {
  id: string = 0;
}

struct DeleteProductResponse {}

method CreateProduct(
  CreateProductRequest
): Product = 1;

method GetProduct(
  GetProductRequest
): Product = 2;

method ListProducts(
  ListProductsRequest
): ProductListResponse = 3;

method DeleteProduct(
  DeleteProductRequest
): DeleteProductResponse = 4;
