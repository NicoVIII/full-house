struct StockSummary {
  product_id: string = 0;
  product_name: string = 1;
  quantity: int32 = 2;
}

struct CreateStockItemRequest {
  product_id: string = 0;
  best_before_date: string = 1;
}

struct StockItem {
  id: string = 0;
  product_id: string = 1;
  best_before_date: string = 2;
}

struct StockListResponse {
  data: [StockSummary] = 0;
  total: int32 = 1;
  offset: int32 = 2;
  limit: int32 = 3;
}

struct ListStockItemsRequest {
  offset: int32 = 0;
  limit: int32 = 1;
}

method CreateStockItem(
  CreateStockItemRequest
): StockItem = 5;

method ListStockItems(
  ListStockItemsRequest
): StockListResponse = 6;
