{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "server: build",
            "type": "shell",
            "command": "gleam build",
            "options": {
                "cwd": "${workspaceFolder}/server"
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "server: lint",
            "type": "shell",
            "command": "gleam run -m lint",
            "options": {
                "cwd": "${workspaceFolder}/server"
            },
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "server: test",
            "type": "shell",
            "command": "gleam test",
            "options": {
                "cwd": "${workspaceFolder}/server"
            },
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "client-web: type-check",
            "type": "shell",
            "command": "bun x --no-install tsc --noEmit",
            "options": {
                "cwd": "${workspaceFolder}/client-web"
            },
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": [
                "$tsc"
            ]
        },
        {
            "label": "client-web: lint",
            "type": "shell",
            "command": "bun run lint",
            "options": {
                "cwd": "${workspaceFolder}/client-web"
            },
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "client-web: test",
            "type": "shell",
            "command": "bun run test:run",
            "options": {
                "cwd": "${workspaceFolder}/client-web"
            },
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "client-web: build",
            "type": "shell",
            "command": "bun run build",
            "options": {
                "cwd": "${workspaceFolder}/client-web"
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": [
                "$tsc"
            ]
        }
    ]
}
