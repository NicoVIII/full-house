// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/universal
{
	"name": "Full House Dev Container",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/base:3-resolute",
	// Features to add to the dev container. More info: https://containers.dev/features.
	"features": {
		"ghcr.io/devcontainers/features/git-lfs:1": { },
		"ghcr.io/NicoVIII/devcontainer-features/lefthook:0": { },
		// Backend
		"ghcr.io/NicoVIII/devcontainer-features/gleam:0": {
			"version": "1.16.0"
		},
		// Frontend
		"ghcr.io/devcontainers-extra/features/bun:1": { },
		// Deployment
		"ghcr.io/devcontainers/features/docker-in-docker:3": {
			"moby": false
		}
	},
	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],
	// Use 'postCreateCommand' to run commands after the container is created.
	"postCreateCommand": "sudo chmod +x ./.devcontainer/post_create.sh && ./.devcontainer/post_create.sh",
	"postStartCommand": "lefthook install && ./skir.sh gen && cd client-web && bun install",
	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			"extensions": [
				// General
				"editorconfig.editorconfig",
				"FanaticPythoner.better-todo-tree",
				"timonwong.shellcheck",
				// Docs
				"MermaidChart.vscode-mermaid-chart",
				// API
				"TylerFibonacci.skir-language",
				// Webclient
				"oxc.oxc-vscode",
				"dbaeumer.vscode-eslint"
			]
		}
	}
	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
